# DataForge Configuration
# Copy this file to .env and fill in your values

# ==================== Core Configuration ====================
DATAFORGE_ENV=development  # development, staging, production
DATAFORGE_LOG_LEVEL=INFO   # DEBUG, INFO, WARNING, ERROR
DATAFORGE_WORKSPACE_DIR=~/dataforge-workspaces

# ==================== AI/LLM Configuration ====================
# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: OpenAI for fallback or comparison
# OPENAI_API_KEY=your_openai_api_key_here

# Model Configuration
DEFAULT_MODEL=claude-3-5-sonnet-20241022
MODEL_TEMPERATURE=0.0
MODEL_MAX_TOKENS=4096

# ==================== Database Connections ====================
# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DATABASE=dataforge_metadata

# MySQL (optional)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_mysql_password
# MYSQL_DATABASE=dataforge_metadata

# ==================== Data Warehouse Connections ====================
# Snowflake
# SNOWFLAKE_ACCOUNT=your_account.region
# SNOWFLAKE_USER=your_username
# SNOWFLAKE_PASSWORD=your_password
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_DATABASE=your_database
# SNOWFLAKE_SCHEMA=your_schema
# SNOWFLAKE_ROLE=your_role

# BigQuery
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
# GCP_PROJECT_ID=your_gcp_project_id
# BIGQUERY_DATASET=your_dataset

# Redshift
# REDSHIFT_HOST=your_cluster.region.redshift.amazonaws.com
# REDSHIFT_PORT=5439
# REDSHIFT_USER=your_username
# REDSHIFT_PASSWORD=your_password
# REDSHIFT_DATABASE=your_database

# ==================== MCP Server Configuration ====================
# MCP servers are configured in ~/.dataforge/mcp-servers.yml
# This section is for connection credentials only

# Example API Keys for MCP servers
# STRIPE_API_KEY=sk_test_...
# SALESFORCE_CLIENT_ID=your_client_id
# SALESFORCE_CLIENT_SECRET=your_client_secret
# HUBSPOT_API_KEY=your_hubspot_key

# ==================== Cloud Storage ====================
# AWS S3
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_DEFAULT_REGION=us-east-1
# S3_BUCKET_NAME=your_bucket

# GCS
# GCS_BUCKET_NAME=your_bucket

# Azure Blob Storage
# AZURE_STORAGE_CONNECTION_STRING=your_connection_string
# AZURE_CONTAINER_NAME=your_container

# ==================== Git Configuration ====================
GITHUB_TOKEN=your_github_token  # For creating PRs, etc.
# GITLAB_TOKEN=your_gitlab_token
# BITBUCKET_TOKEN=your_bitbucket_token

# Git Config
GIT_USER_NAME=DataForge Bot
GIT_USER_EMAIL=bot@dataforge.dev

# ==================== API Server Configuration ====================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true  # Set to false in production

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173  # Comma-separated

# Authentication
API_SECRET_KEY=your_secret_key_here_change_in_production
API_ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours

# ==================== Security ====================
# Encryption key for storing sensitive credentials
CREDENTIAL_ENCRYPTION_KEY=your_encryption_key_here_change_in_production

# PII Detection
ENABLE_PII_DETECTION=true
PII_SCAN_SAMPLE_SIZE=1000  # Number of rows to sample for PII detection

# Audit Logging
ENABLE_AUDIT_LOGGING=true
AUDIT_LOG_PATH=~/.dataforge/audit.log

# ==================== Features Flags ====================
ENABLE_WEB_INTERFACE=false  # Phase 3
ENABLE_VSCODE_EXTENSION=false  # Phase 2
ENABLE_PIPELINE_GENERATION=false  # Phase 2
ENABLE_INFRASTRUCTURE_GENERATION=false  # Phase 3

# ==================== Rate Limiting ====================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ==================== Observability ====================
# Sentry (optional)
# SENTRY_DSN=your_sentry_dsn

# OpenTelemetry (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ==================== Development Only ====================
# Database for testing
TEST_DATABASE_URL=sqlite:///./test.db

# Debug Mode
DEBUG=false

# Profiling
ENABLE_PROFILING=false
